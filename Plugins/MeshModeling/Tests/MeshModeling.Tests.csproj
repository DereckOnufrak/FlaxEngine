<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone NUnit test project for MeshModeling's pure-geometry code (EditableMeshBuilder/EditableMeshData).
    This is NOT built by Flax.Build - it's a normal dotnet test project you run after building the plugin,
    mirroring the recipe this engine repo's own AGENTS.md documents for "managed engine tests":
    build the plugin's Editor target, then point the two HintPaths below at the resulting DLLs and `dotnet test`.

    The exact output paths/filenames depend on your Flax.Build output layout and haven't been verified against a
    real build - adjust the HintPaths below to match what you actually get after building
    MeshModelingEditorTarget (look under Plugins/MeshModeling/Binaries/... for MeshModeling.dll, and under this
    repo's own Binaries/Editor/<Platform>/Development for FlaxEngine.CSharp.dll).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODO: point this at the built MeshModeling runtime module DLL -->
    <Reference Include="MeshModeling">
      <HintPath>..\Binaries\Editor\Win64\Development\MeshModeling.dll</HintPath>
    </Reference>
    <!-- TODO: point this at this engine build's FlaxEngine.CSharp.dll -->
    <Reference Include="FlaxEngine.CSharp">
      <HintPath>..\..\..\Binaries\Editor\Win64\Development\FlaxEngine.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
